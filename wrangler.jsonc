// Web Worker (SvelteKit). docs/architecture.md#configuration-and-deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reel-web",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reel",
      "migrations_dir": "migrations",
      "database_id": "26fb05ba-4782-4ea5-babc-549452dd7c0a",
    },
  ],
  "routes": [{ "pattern": "thereelcapital.com", "custom_domain": true }],
  "durable_objects": {
    "bindings": [
      {
        "name": "ENGINE",
        "class_name": "ClientCoordinator",
        "script_name": "reel-engine",
      },
    ],
  },
}
