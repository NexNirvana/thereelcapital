{
  "name": "thereelcapital",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite build && wrangler dev -c wrangler.jsonc -c engine/wrangler.jsonc",
    "build": "vite build",
    "types": "wrangler types -c wrangler.jsonc -c engine/wrangler.jsonc && wrangler types -c engine/wrangler.jsonc engine/worker-configuration.d.ts --env-interface EngineEnv --include-runtime=false",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "market-calendar": "1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/adapter-cloudflare": "8.0.0",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/bun": "1.4.3",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "wrangler": "4.150.0"
  }
}
