# Throwaway test values, not credentials. Loaded next to the engine's wrangler vars by
# playwright.config.ts: the engine trades through the in-memory local simulation, with its clock
# pinned inside a regular session (Wednesday 2026-11-04, 10:00 in New York).
CREDENTIALS_KEY=BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc=
BROKER=local-sim
ENVIRONMENT=test
TEST_NOW=2026-11-04T15:00:00Z
# The sync tick is 5 s in production; a shorter one keeps SETTLE_MS (support.ts) small.
TEST_SYNC_MS=1000
# The engine's deployment switch for REAL (D52 lock 1). Only here: REAL then reaches the local simulation's
# REAL-1 account, never a TradeStation host; engine/wrangler.jsonc keeps "disabled".
REAL_TRADING=enabled
