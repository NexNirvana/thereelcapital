// Engine Worker: owns the ClientCoordinator Durable Object. docs/architecture.md#configuration-and-deploy
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "reel-engine",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reel",
      "database_id": "26fb05ba-4782-4ea5-babc-549452dd7c0a",
    },
  ],
  // Which broker the engine talks to. "tradestation" is TradeStation SIM; "local-sim" is honoured only
  // when ENVIRONMENT is "development" or "test" (broker/select.ts). Local runs override in .dev.vars.
  // TEST_NOW stays empty: it only pins the clock of the local simulation (clock.ts), and a var must be
  // declared here for a local env file to set it. TEST_SYNC_MS likewise shortens the sync tick there.
  "vars": {
    "BROKER": "tradestation",
    "ENVIRONMENT": "production",
    // The first lock of REAL mode (D52): only the exact value "enabled" opens it. Only the owner
    // changes it, in a PR of their own; agents, scripts, tests and CI never do.
    "REAL_TRADING": "disabled",
    "TEST_NOW": "",
    "TEST_SYNC_MS": "",
  },
  "durable_objects": {
    "bindings": [{ "name": "COORDINATOR", "class_name": "ClientCoordinator" }],
  },
  // Set with `wrangler secret put CREDENTIALS_KEY --name reel-engine`: base64 of 32 random bytes
  // (`openssl rand -base64 32`). Never in this file. CREDENTIALS_KEY_PREVIOUS is set only during a
  // rotation (docs/runbook.md#secrets) and stays out of `required`.
  "secrets": { "required": ["CREDENTIALS_KEY"] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ClientCoordinator"] }],
}
