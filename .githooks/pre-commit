#!/bin/sh
# Blocks commits that break CONTRIBUTING.md: wrong identity, secrets,
# conflict markers, oversized files.
set -eu

name="OnishellT"
email="46875497+OnishellT@users.noreply.github.com"
max_bytes=5242880
status=0

err() {
  printf 'pre-commit: %s\n' "$1" >&2
  status=1
}

for ident in "$(git var GIT_AUTHOR_IDENT)" "$(git var GIT_COMMITTER_IDENT)"; do
  case "$ident" in
    "$name <$email> "*) ;;
    *) err "author and committer must be $name <$email> (see CONTRIBUTING.md#setup)" ;;
  esac
done

# NUL-separated so names with spaces, tabs, newlines or non-ASCII bytes are checked.
git diff --cached --name-only -z --diff-filter=ACMR | xargs -0 -r sh -c '
  max_bytes=$1
  shift
  rc=0
  for f; do
    case "$(basename "$f")" in
      .dev.vars.example | .env.example) ;;
      .dev.vars | .dev.vars.* | .env | .env.* | *.pem | *.key | *.p12)
        printf "pre-commit: %s looks like a secrets file; keep it out of Git\n" "$f" >&2
        rc=1 ;;
    esac
    size=$(git cat-file -s ":$f")
    if [ "$size" -gt "$max_bytes" ]; then
      printf "pre-commit: %s is larger than 5 MB\n" "$f" >&2
      rc=1
    fi
  done
  exit "$rc"
' sh "$max_bytes" || status=1

added=$(git diff --cached -U0 --diff-filter=ACMR --output-indicator-new='>' | grep '^>' || true)

if printf '%s\n' "$added" | grep -Eq '^>(<<<<<<<|>>>>>>>)( |$)'; then
  err "merge conflict markers in staged changes"
fi

if printf '%s\n' "$added" | grep -Eq -e '-----BEGIN [A-Z ]*PRIVATE KEY-----' \
  -e 'gh[pousr]_[A-Za-z0-9]{36}' -e 'github_pat_[A-Za-z0-9_]{40,}' \
  -e 'AKIA[0-9A-Z]{16}' -e 'sk_(live|test)_[A-Za-z0-9]{16,}' -e 'xox[abprs]-[A-Za-z0-9-]{10,}'; then
  err "staged changes contain what looks like a secret or private key"
fi

# TradeStation SIM only (shared with CI).
"$(dirname "$0")/no-live-host" --cached || status=1

# Formatter and linter on the staged contents (not the working tree), once dependencies are installed.
if [ -d node_modules ]; then
  git diff --cached --name-only -z --diff-filter=ACMR -- . ':(exclude)*worker-configuration.d.ts' |
    xargs -0 -r sh -c '
      rc=0
      for f; do
        git show ":$f" | node_modules/.bin/prettier --check --ignore-unknown --stdin-filepath "$f" >/dev/null 2>&1 || {
          printf "pre-commit: Prettier check failed for %s\n" "$f" >&2
          rc=1
        }
      done
      exit "$rc"
    ' sh || err "Prettier check failed; run 'bun run format' and stage the result"
  git diff --cached --name-only -z --diff-filter=ACMR -- '*.js' '*.ts' '*.svelte' \
    ':(exclude)*worker-configuration.d.ts' |
    xargs -0 -r sh -c '
      rc=0
      for f; do
        git show ":$f" | node_modules/.bin/eslint --stdin --stdin-filename "$f" || rc=1
      done
      exit "$rc"
    ' sh || err "ESLint failed; run 'bun run lint' and stage the result"
fi

exit "$status"
